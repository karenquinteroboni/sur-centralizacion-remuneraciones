# Copie a .env (ignorado por git). Los tokens NUNCA van en el repo.
# Token de Buk de SOLO LECTURA, limitado a la empresa (Buk > API Key > "Limitar acceso por Empresas").
BUK_TOKEN_EXTERILIZA=
# name/rut opcionales (se leen de Buk); si el RUT se informa, se verifica contra Buk.
# Cuenta con varias empresas: agregue "bukCompanyId": <id de la empresa en Buk>.
BUK_COMPANIES=[{"id":"exteriliza","name":"EXTERILIZA SPA","rut":"76.282.756-5","subdomain":"exteriliza","tokenEnv":"BUK_TOKEN_EXTERILIZA"}]
